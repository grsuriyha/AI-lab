    "def ids(initial):\n",
    "\n",
    "    depth = 0\n",
    "\n",
    "    while True:\n",
    "\n",
    "        print(\"Searching at depth:\", depth)\n",
    "        result = dls(initial, depth, [initial])\n",
    "        if result is not None:\n",
    "            return result\n",
    "\n",
    "        depth += 1\n",
    "\n",
    "# Main\n",
    "print(\"Enter initial state:\")\n",
    "\n",
    "initial = []\n",
    "\n",
    "for i in range(9):\n",
