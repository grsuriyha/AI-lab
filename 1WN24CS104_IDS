    "\n",
    "initial = tuple(initial)\n",
    "\n",
    "solution = ids(initial)\n",
    "\n",
    "\n",
    "print(\"\\nSolution Found!\")\n",
    "print(\"Number of moves:\", len(solution) - 1)\n",
    "\n",
    "for i, state in enumerate(solution):\n",
    "\n",
    "    print(\"Step\", i)\n",
    "    print_puzzle(state)                 "
